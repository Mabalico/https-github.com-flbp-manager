# Copiare come .env. Non committare mai questo file compilato.
FLBP_HOST=0.0.0.0
FLBP_PORT=8787
FLBP_WORKSPACE_ID=default
FLBP_DATA_DIR=./data
FLBP_WEB_DIST=../FLBP ONLINE/dist

# Opzionale ma consigliato: cartella su un secondo disco/USB. Quando presente,
# ogni commit viene confermato solo dopo la replica di quella versione.
FLBP_SECONDARY_BACKUP_DIR=
FLBP_REQUIRE_SECONDARY_BACKUP=1
FLBP_SECONDARY_BACKUP_RETENTION=24
FLBP_SECONDARY_BACKUP_INTERVAL_MS=300000
FLBP_HISTORY_RETENTION_DAYS=90
FLBP_HISTORY_MIN_VERSIONS=2000

# Token lungo e casuale usato dal pannello Admin verso il server locale.
FLBP_LOCAL_ADMIN_TOKEN=CAMBIARE_CON_UN_TOKEN_CASUALE_DI_ALMENO_32_CARATTERI

# Origini autorizzate, separate da virgola. Aggiungere un dominio solo se si usa il tunnel opzionale.
FLBP_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Opzionale. Lasciare vuoto per tenere Admin/TV sulla LAN e far leggere il pubblico da Supabase.
# Compilare soltanto se si vuole esporre il server locale tramite un tunnel HTTPS.
FLBP_LOCAL_PUBLIC_URL=

# Supabase: la Secret key server rimane esclusivamente su questo PC, mai nel frontend.
# È ancora accettata SUPABASE_SERVICE_ROLE_KEY per installazioni legacy.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Journal in piccoli batch, mirror pubblico ritardato, snapshot completo e heartbeat leadership.
# Le richieste ordinarie vengono interrotte dopo 15 s; attivazione,
# disattivazione, riconciliazione e backup completo hanno 60 s.
FLBP_SUPABASE_REQUEST_TIMEOUT_MS=15000
FLBP_SUPABASE_TRANSITION_TIMEOUT_MS=60000
FLBP_OUTBOX_FLUSH_INTERVAL_MS=15000
FLBP_OUTBOX_BATCH_MAX_OPERATIONS=25
FLBP_OUTBOX_BATCH_MAX_BYTES=524288
FLBP_PUBLIC_LIVE_INTERVAL_MS=60000
FLBP_FULL_BACKUP_INTERVAL_MS=1800000
FLBP_HEARTBEAT_INTERVAL_MS=15000
FLBP_LEASE_TTL_SECONDS=60
